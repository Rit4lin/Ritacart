# Application
APP_ENV=development
APP_TIMEZONE=Europe/Madrid
# Docker Compose fuerza /data dentro del contenedor. Estos valores facilitan el desarrollo local.
APP_DATA_DIR=./data
DATABASE_URL=sqlite:///./data/ritacart.db

# Email ingestion
EMAIL_HOST=imap.gmail.com
EMAIL_PORT=993
EMAIL_USE_SSL=true
EMAIL_USERNAME=
# Para Gmail, usa una contraseña de aplicación; nunca la añadas a Git.
EMAIL_PASSWORD=
EMAIL_FOLDER=INBOX
EMAIL_RECEIPT_SENDER=ticket_digital@mail.mercadona.com
EMAIL_POLL_INTERVAL_MINUTES=15

# Local server
HOST=0.0.0.0
PORT=8000
